# Dockerfile.zena — aegra runtime image with zena graph deps pre-installed.
#
# Graph code (/deps/langgraph/) is volume-mounted at runtime, but its Python
# dependencies (aiohttp, langchain-*, langgraph-*, qdrant-client, fastembed,
# fastmcp, openai, psycopg, etc.) must be baked into the image so the graph
# modules can import without runtime pip-install.
#
# Build context MUST be the zena repo root (one level above aegra/), so that
# both aegra/ and langgraph/pyproject.toml are visible. See
# docker-compose.zena.dev.yml.
#
# Layout mirrors upstream aegra/deployments/docker/Dockerfile — the only
# addition is the final RUN that installs zena graph deps from
# langgraph/pyproject.toml. If upstream Dockerfile changes, re-sync stages
# here.

ARG PY_VERSION=3.12
FROM python:${PY_VERSION}-slim-bookworm AS base
ARG PY_VERSION

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=off \
    PIP_DISABLE_PIP_VERSION_CHECK=on \
    PIP_DEFAULT_TIMEOUT=100

WORKDIR /app

RUN addgroup --system app && adduser --system --ingroup app app

# -----------------------------
# Builder stage — aegra-api (same as upstream)
# -----------------------------
FROM base AS builder

COPY --from=ghcr.io/astral-sh/uv:0.10.0 /uv /bin/uv

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY aegra/libs/aegra-api/pyproject.toml aegra/libs/aegra-api/README.md ./
COPY aegra/uv.lock ./

RUN uv export --frozen --no-emit-project --format=requirements-txt > requirements.txt && \
    uv pip install --system --compile-bytecode -r requirements.txt && \
    rm requirements.txt

COPY aegra/libs/aegra-api/src/ ./src/
COPY aegra/libs/aegra-api/alembic.ini ./alembic.ini
COPY aegra/libs/aegra-api/alembic/ ./alembic/

RUN uv pip install --system --compile-bytecode --no-deps .

# -----------------------------
# Zena deps stage — installs langgraph graph runtime deps on top of aegra
# -----------------------------
FROM builder AS zena-builder

COPY langgraph/pyproject.toml /tmp/zena-lg-pyproject.toml

# Extract [project.dependencies] from pyproject, skip langgraph-api (licensed,
# not needed under aegra), install via uv into the same site-packages.
RUN python -c "import tomllib; d=tomllib.load(open('/tmp/zena-lg-pyproject.toml','rb')); print('\n'.join(x for x in d['project']['dependencies'] if not x.startswith('langgraph-api')))" > /tmp/zena-lg-deps.txt && \
    uv pip install --system --compile-bytecode -r /tmp/zena-lg-deps.txt && \
    rm /tmp/zena-lg-pyproject.toml /tmp/zena-lg-deps.txt

# -----------------------------
# Final runtime image (same layout as upstream, but copying from zena-builder)
# -----------------------------
FROM base AS final

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=zena-builder /usr/local/lib/python${PY_VERSION}/site-packages/ /usr/local/lib/python${PY_VERSION}/site-packages/
COPY --from=zena-builder /usr/local/bin/ /usr/local/bin/

COPY aegra/libs/aegra-api/alembic.ini ./alembic.ini
COPY aegra/libs/aegra-api/alembic/ ./alembic/
COPY aegra/aegra.json ./aegra.json
COPY aegra/examples/ ./examples/

EXPOSE 2026

USER app

CMD ["aegra", "serve"]
